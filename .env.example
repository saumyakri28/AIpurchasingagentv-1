# Copy to .env and fill in. NEVER commit real keys.
#
# The eval suite (`make eval`) forces LLM_PROVIDER=fake and needs NO API key.
# Leave LLM_PROVIDER=fake for local demos too; canned FakeLLM scripts drive
# the four scenarios. Set LLM_PROVIDER=anthropic and fill ANTHROPIC_API_KEY
# only when you want a live model.

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_PROVIDER=fake

# Autonomy envelope (USD). Orders above this go to the approval queue.
AUTONOMY_MAX_ORDER_VALUE=5000

# SQLite file is created next to the backend working directory unless overridden.
DB_URL=sqlite:///./purchasing_agent.db

# fixture = behaviours come from the scenario YAML, never from randomness
SUPPLIER_API_MODE=fixture

# Frontend origin(s) allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
